#!/usr/bin/env bash
set -euo pipefail

# FortAI's native server launcher.  It never execs llama-server: the CUDA
# binary is preferred, and the Fortran-only binary is retained for explicit
# CPU diagnostics (`FORTAI_SERVER_BIN=...` can select either one).
root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
server_path="${FORTAI_SERVER_BIN:-$root_dir/build/cuda/fortai_server}"
if [[ ! -x "$server_path" ]]; then
    server_path="$root_dir/build/fo/bin/fortai_server"
fi
if [[ ! -x "$server_path" ]]; then
    echo "FortAI native server is not built; run tools/build_cuda_server.sh (CUDA) or fo build (CPU)" >&2
    exit 127
fi

exec "$server_path" "$@"
