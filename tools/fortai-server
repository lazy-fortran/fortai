#!/usr/bin/env bash
set -euo pipefail

# FortAI's production server entrypoint.  Keep the complete llama.cpp CLI and
# service ABI available by forwarding argv unchanged to the locally installed
# upstream server.  The native single-sequence runners remain useful for
# kernel/model experiments, but they are not a replacement for the evolving
# chat, multimodal, sampler, slot, and speculative-server surface.
server_path="${FORTAI_LLAMA_SERVER:-${LLAMACPP_SERVER:-${LLAMA_SERVER:-/home/ert/.local/bin/llama-server}}}"

if [[ "$server_path" != */* ]]; then
    server_path=$(command -v "$server_path" || true)
fi
if [[ -z "$server_path" || ! -x "$server_path" ]]; then
    echo "FortAI compatibility server not found: ${FORTAI_LLAMA_SERVER:-${LLAMACPP_SERVER:-${LLAMA_SERVER:-/home/ert/.local/bin/llama-server}}}" >&2
    exit 127
fi

exec "$server_path" "$@"
